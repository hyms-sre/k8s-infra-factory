# =============================================================================
# secrets.env.example — 凭据登记模板 (复制为 secrets.env 并填写; secrets/ 已 gitignore)
#
# 本项目核心凭据的实际管理方式见 docs/14-credentials.md:
#   - vSphere 凭据: terraform/vsphere/terraform.tfvars 或 TF_VAR_* 环境变量
#   - SSH: ~/.ssh/id_ed25519 (config/default.yaml 的 ssh 段指定公钥)
#   - kubeconfig: master 节点 /etc/kubernetes/admin.conf → 本机 ~/.kube/config
# 本文件仅作部署后各类口令的本地登记 (非 Git 管理), 全部使用占位符。
# =============================================================================

# vCenter (与 terraform.tfvars 保持一致)
VAULT_VCENTER_USER='administrator@example.local'
VAULT_VCENTER_PASSWORD='CHANGE_ME'

# Linux 运维账号备用密码 (默认仅密钥登录)
VAULT_OS_ADMIN_PASSWORD=''

# Harbor (admin 用户)
VAULT_HARBOR_ADMIN_PASSWORD=''

# Harbor 内置 PostgreSQL 口令 (首次安装写入 DB; 改配置必须与 DB 实际口令一致)
VAULT_HARBOR_DB_PASSWORD=''

# OpenWrt root
VAULT_OPENWRT_ROOT_PASSWORD=''

# OpenClash 订阅 URL (个人隐私, 仅本地保存)
VAULT_OPENCLASH_SUBSCRIPTION=''
